{
  "name": "@edge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "catalog:",
    "@edge/contracts": "workspace:*",
    "@edge/db": "workspace:*",
    "@edge/domain": "workspace:*",
    "@edge/integrations": "workspace:*",
    "@edge/jobs": "workspace:*",
    "@edge/services": "workspace:*",
    "better-auth": "catalog:",
    "helmet": "^8.3.0",
    "express-rate-limit": "^8.7.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@edge/config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "supertest": "^7.3.1",
    "@types/supertest": "^7.2.0",
    "mongodb-memory-server": "catalog:"
  }
}
