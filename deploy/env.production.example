# Edge Academy: PRODUCTION environment (development uses .env.example at the repo root).
#
# On the server, at the repo root (deploy/setup.sh does this for you if .env is missing):
#   cp deploy/env.production.example .env && chmod 600 .env && nano .env
# Never commit .env. Keep a copy in the password manager.
#
# Every process reads this one file (Node's --env-file): api, worker, student, console, crm, migrate.
# Production refuses mock modes and development secrets. Generate secrets with:  openssl rand -base64 48
#
# Format: one KEY=value per line. An unquoted value ends at "#", so quote values containing "#".
# Never set PORT, HOSTNAME, DEV_ROUTES or ALLOW_MOCK_IN_PRODUCTION here (PM2 sets the ports per app).
# After editing: pm2 restart all   (or run ./deploy/deploy.sh)

NODE_ENV=production

# --- Public URLs (https, no trailing slash; must match deploy/nginx.conf) ---
STUDENT_APP_URL=https://portal.edgeacademy.ae
CONSOLE_APP_URL=https://console.edgeacademy.ae
CRM_APP_URL=https://crm.edgeacademy.ae
API_PUBLIC_URL=https://api.edgeacademy.ae
# Where the Next apps reach the API on this server (also compiled into their rewrites at build time).
API_INTERNAL_URL=http://127.0.0.1:4000
INTERNAL_API_TOKEN=
TZ_DEFAULT=Asia/Dubai

# --- Database and queues ---
# Keep the /edge path: without it the driver silently uses a database called "test".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/edge?retryWrites=true&w=majority&appName=edge-academy
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_PREFIX=edge

# --- Secrets ---
# Changing BETTER_AUTH_SECRET signs everyone out and breaks two-factor setups;
# changing MEDIA_SIGNING_SECRET invalidates open video links.
BETTER_AUTH_SECRET=
MEDIA_SIGNING_SECRET=
REQUIRE_ADMIN_2FA=true

# First super admin, created once by migrate (password: 12+ characters; must be changed at first
# sign-in). Clear SEED_ADMIN_PASSWORD after that first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Twilio Verify (mobile OTP, SMS + WhatsApp) ---
OTP_MODE=live
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Transactional email (MailerSend; the address must be on a verified domain) ---
# console = nothing is sent; each email is printed to `pm2 logs edge-worker` instead (until MailerSend is set up).
EMAIL_MODE=mailersend
EMAIL_FROM=Edge Trading Academy <no-reply@edgeacademy.ae>
MAILERSEND_API_KEY=

# --- Payments ---
# sandbox and live run the same code: the keys decide whether real money moves.
# Start with test keys and PAYMENTS_MODE=sandbox; at go-live switch to live keys (docs/DEPLOYMENT.md).
PAYMENTS_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NOMOD_API_KEY=
NOMOD_WEBHOOK_SECRET=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
# Any long random string (openssl rand -hex 32); also given to Tabby when registering the webhook.
TABBY_WEBHOOK_HEADER_VALUE=
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
# This pins Tamara to its sandbox. At go-live change it to https://api.tamara.co (or delete the line).
TAMARA_API_URL=https://api-sandbox.tamara.co

# --- Odoo (needs the Custom plan for API access) ---
ODOO_MODE=live
ODOO_URL=https://edge-verse.odoo.com
ODOO_DB=
ODOO_API_KEY=

# --- Google Workspace (Meet + Drive) via a service account with domain-wide delegation ---
GOOGLE_MODE=live
# The JSON key as one base64 line:  base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# A real Workspace user (not a group): hosts classes for mentors without a Workspace email and
# reads Drive recordings, so share recording files with it.
GOOGLE_DEFAULT_ORGANIZER=
# Video cache (in <repo>/.media-cache). Roughly: disk size minus 50 GB.
MEDIA_CACHE_MAX_GB=150

# --- MailerLite (marketing groups) ---
MAILERLITE_MODE=live
MAILERLITE_API_KEY=

# --- CRM: website lead form intake (docs/CRM.md). openssl rand -hex 32 ---
LEAD_WEBHOOK_SECRET=

# --- CRM: sites whose browser forms post to /api/public/* (Forex Growth Hub) ---
PUBLIC_FORM_ORIGINS=https://growthhub.edgeacademy.ae,https://forex-growth-hub.vercel.app
