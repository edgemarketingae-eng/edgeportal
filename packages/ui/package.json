{
  "name": "@edge/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./brand/*": "./src/brand/*.tsx",
    "./shell/*": "./src/shell/*.tsx",
    "./forms/*": "./src/forms/*.tsx",
    "./blocks/*": "./src/blocks/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
