# Edge Academy: DEVELOPMENT environment.
#
#   cp .env.example .env        (at the repo root, next to this file)
#
# One file for the whole monorepo. `pnpm dev` / `npx turbo dev` starts four apps and each reads it:
#   apps/api, apps/worker      through `--env-file-if-exists=../../.env` in their package.json scripts
#   apps/student, apps/console through next.config.ts
# Turborepo itself does not load .env files; it only hashes this one so cached builds stay correct.
#
# Precedence: variables already set in your shell > this file > built-in defaults.
# The file is optional: with no .env every integration is mocked (OTP code 000000, a test checkout
# page instead of real gateways, emails printed by the worker, fake Meet links, fixtures/sample.mp4
# as every Drive video). Restart `pnpm dev` after editing it.
#
# Other environments do NOT use this file:
#   tests (pnpm check / pnpm test)  each suite sets its own values (packages/*/test/setup.ts, apps/api/test/setup.ts)
#   e2e (pnpm test:e2e)             e2e/stack.ts sets everything for its isolated stack
#   production (PM2 on the VPS)     .env at the repo root on the server, from deploy/env.production.example
#
# This file is committed: keep only placeholders and dev defaults in it, never real credentials.
# Don't set NODE_ENV or PORT here: development is the default and each app has its own port.

# ---------------------------------------------------------------------------------------------
# Shared by all four apps
# ---------------------------------------------------------------------------------------------
# The Next apps send this to the API on every internal call; it must be the same everywhere.
INTERNAL_API_TOKEN=dev-internal-token-change-me-0123456789
STUDENT_APP_URL=http://student.localhost:3000
CONSOLE_APP_URL=http://console.localhost:3001
# Public base of the API (signed video URLs point here).
API_PUBLIC_URL=http://localhost:4000

# ---------------------------------------------------------------------------------------------
# Next apps (student, console)
# ---------------------------------------------------------------------------------------------
# Where the Next servers reach the API (server-side calls and the /api/auth rewrites).
API_INTERNAL_URL=http://127.0.0.1:4000

# ---------------------------------------------------------------------------------------------
# API + worker
# ---------------------------------------------------------------------------------------------
# `pnpm dev:db` runs this local replica set (transactions need a replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/edge_dev?replicaSet=rs0
BULLMQ_PREFIX=edge
BETTER_AUTH_SECRET=dev-only-better-auth-secret-0123456789abcdef
MEDIA_SIGNING_SECRET=dev-only-media-secret-0123
TZ_DEFAULT=Asia/Dubai
# Admin accounts must turn on two-factor before opening the admin panel (default: on in production only).
# REQUIRE_ADMIN_2FA=false
# Video cache for recordings, shared by api and worker (default: .media-cache at the repo root).
# MEDIA_CACHE_DIR=
# MEDIA_CACHE_MAX_GB=150

# --- Integrations: mock | sandbox | live (EMAIL_MODE: console | mailersend) ---
# Switch one at a time to sandbox and fill its keys below to try the real provider locally.
OTP_MODE=mock
EMAIL_MODE=console
PAYMENTS_MODE=mock
ODOO_MODE=mock
GOOGLE_MODE=mock
MAILERLITE_MODE=mock

# Twilio Verify (OTP_MODE=sandbox|live)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# MailerSend (EMAIL_MODE=mailersend)
# EMAIL_FROM=Edge Trading Academy <no-reply@edgeacademy.ae>
# MAILERSEND_API_KEY=

# Payment gateways (PAYMENTS_MODE=sandbox|live). Webhooks need a public URL (Stripe CLI or a tunnel).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NOMOD_API_KEY=
# NOMOD_WEBHOOK_SECRET=
# TABBY_SECRET_KEY=
# TABBY_MERCHANT_CODE=
# TABBY_WEBHOOK_HEADER_VALUE=
# TAMARA_API_TOKEN=
# TAMARA_NOTIFICATION_TOKEN=
# TAMARA_API_URL=https://api-sandbox.tamara.co

# Odoo (ODOO_MODE=sandbox|live)
# ODOO_URL=https://edge-verse.odoo.com
# ODOO_DB=
# ODOO_API_KEY=

# Google Workspace: Meet + Drive (GOOGLE_MODE=sandbox|live)
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DEFAULT_ORGANIZER=
# Mock mode only: the video served for every Drive file (default: fixtures/sample.mp4 at the repo root).
# MOCK_DRIVE_FILE=

# MailerLite (MAILERLITE_MODE=sandbox|live)
# MAILERLITE_API_KEY=

# Seed: first super admin for `pnpm --filter @edge/api migrate`
# (development defaults to admin@edgeacademy.local / ChangeMe!2026).
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
